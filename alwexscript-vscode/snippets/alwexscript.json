  "Simple Class Example": {
    "prefix": "class_simple",
    "body": [
      "class ${1:Person}",
      "    let name = ''",
      "    let age = 0",
      "    ",
      "    func constructor",
      "        let this.name = arg0",
      "        let this.age = arg1",
      "    end",
      "    ",
      "    func greet",
      "        print 'Hello, my name is:'",
      "        print this.name",
      "    end",
      "end",
      "",
      "let ${2:person} = new ${1:Person} '${3:Alex}' ${4:25}",
      "print ${2:person}.name",
      "call ${2:person}.greet"
    ],
    "description": "Simple class with object example (v3.1 — OOP)"
  },
  "OOP Inheritance Example": {
    "prefix": "oop_example",
    "body": [
      "# Base class",
      "class ${1:Animal}",
      "    let name = ''",
      "    let age = 0",
      "    ",
      "    func speak",
      "        print 'Some sound...'",
      "    end",
      "    ",
      "    func info",
      "        print 'Name:'",
      "        print this.name",
      "    end",
      "end",
      "",
      "# Child class with inheritance",
      "class ${2:Dog} extends ${1:Animal}",
      "    let breed = ''",
      "    ",
      "    func constructor",
      "        let this.name = arg0",
      "        let this.breed = arg1",
      "    end",
      "    ",
      "    # Override parent method",
      "    func speak",
      "        print 'Woof! Woof!'",
      "    end",
      "    ",
      "    func fetch",
      "        print 'Fetching the ball!'",
      "    end",
      "end",
      "",
      "# Create objects",
      "let ${3:dog} = new ${2:Dog} 'Rex' 'German Shepherd'",
      "print ${3:dog}.name",
      "print ${3:dog}.breed",
      "call ${3:dog}.speak",
      "call ${3:dog}.info",
      "call ${3:dog}.fetch"
    ],
    "description": "Full OOP example with inheritance (v3.1 — OOP)"
  },
  "Game Object Example": {
    "prefix": "game_object",
    "body": [
      "class ${1:Entity}",
      "    let x = 0",
      "    let y = 0",
      "    let health = 100",
      "    ",
      "    func constructor",
      "        let this.x = arg0",
      "        let this.y = arg1",
      "    end",
      "    ",
      "    func move",
      "        let this.x = this.x plus arg0",
      "        let this.y = this.y plus arg1",
      "    end",
      "    ",
      "    func status",
      "        print 'Position:'",
      "        print this.x",
      "        print this.y",
      "        print 'Health:'",
      "        print this.health",
      "    end",
      "end",
      "",
      "class ${2:Player} extends ${1:Entity}",
      "    let score = 0",
      "    ",
      "    func constructor",
      "        let this.x = arg0",
      "        let this.y = arg1",
      "        let this.score = 0",
      "    end",
      "    ",
      "    func collect",
      "        let this.score = this.score plus 10",
      "        print 'Score:'",
      "        print this.score",
      "    end",
      "end",
      "",
      "let ${3:player} = new ${2:Player} 0 0",
      "call ${3:player}.status",
      "call ${3:player}.move 5 3",
      "call ${3:player}.collect",
      "call ${3:player}.status"
    ],
    "description": "Game object with inheritance example (v3.1 — OOP)"
  },
