{
  "Class Definition": {
    "prefix": "class",
    "body": [
      "class ${1:ClassName}",
      "    let ${2:property} = ${3:0}",
      "    ",
      "    func constructor",
      "        let this.${2:property} = arg0",
      "    end",
      "    ",
      "    func ${4:methodName}",
      "        $0",
      "    end",
      "end"
    ],
    "description": "Create a new class (v3.1 — OOP)"
  },
  "Class with Inheritance": {
    "prefix": "classext",
    "body": [
      "class ${1:ChildClass} extends ${2:ParentClass}",
      "    let ${3:property} = ${4:0}",
      "    ",
      "    func constructor",
      "        let this.${3:property} = arg0",
      "    end",
      "    ",
      "    func ${5:methodName}",
      "        $0",
      "    end",
      "end"
    ],
    "description": "Create a child class with inheritance (v3.1 — OOP)"
  },
